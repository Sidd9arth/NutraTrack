/// Pure validation functions. Return an error string if invalid, null if valid.
/// Compatible with Flutter's [FormField.validator] signature.
abstract final class Validators {
  // ---------------------------------------------------------------------------
  // Auth
  // ---------------------------------------------------------------------------

  static String? email(String? value) {
    if (value == null || value.trim().isEmpty) return 'Email is required.';
    if (!value.isValidEmail) return 'Please enter a valid email address.';
    return null;
  }

  static String? password(String? value) {
    if (value == null || value.isEmpty) return 'Password is required.';
    if (value.length < 8) return 'Password must be at least 8 characters.';
    return null;
  }

  static String? confirmPassword(String? value, String? original) {
    final base = password(value);
    if (base != null) return base;
    if (value != original) return 'Passwords do not match.';
    return null;
  }

  // ---------------------------------------------------------------------------
  // Profile
  // ---------------------------------------------------------------------------

  static String? displayName(String? value) {
    if (value == null || value.trim().isEmpty) return 'Name is required.';
    if (value.trim().length < 2) return 'Name must be at least 2 characters.';
    return null;
  }

  static String? heightCm(String? value) {
    if (value == null || value.trim().isEmpty) return null; // optional
    final parsed = double.tryParse(value.trim());
    if (parsed == null) return 'Please enter a valid height.';
    if (parsed < 50 || parsed > 280) return 'Height must be between 50 and 280 cm.';
    return null;
  }

  // ---------------------------------------------------------------------------
  // Nutrition
  // ---------------------------------------------------------------------------

  static String? servingSize(String? value) {
    if (value == null || value.trim().isEmpty) return 'Serving size is required.';
    final parsed = double.tryParse(value.trim());
    if (parsed == null) return 'Please enter a number.';
    if (parsed <= 0) return 'Serving size must be greater than 0.';
    return null;
  }

  static String? calories(String? value) {
    if (value == null || value.trim().isEmpty) return 'Calories are required.';
    final parsed = double.tryParse(value.trim());
    if (parsed == null) return 'Please enter a number.';
    if (parsed < 0) return 'Calories cannot be negative.';
    return null;
  }

  static String? macroGrams(String? value, {bool required = false}) {
    if (value == null || value.trim().isEmpty) {
      return required ? 'This field is required.' : null;
    }
    final parsed = double.tryParse(value.trim());
    if (parsed == null) return 'Please enter a number.';
    if (parsed < 0) return 'Value cannot be negative.';
    return null;
  }

  static String? weight(String? value) {
    if (value == null || value.trim().isEmpty) return 'Weight is required.';
    final parsed = double.tryParse(value.trim());
    if (parsed == null) return 'Please enter a number.';
    if (parsed <= 0 || parsed > 999) return 'Please enter a realistic weight.';
    return null;
  }

  static String? required(String? value, {String fieldName = 'This field'}) {
    if (value == null || value.trim().isEmpty) return '$fieldName is required.';
    return null;
  }
}
