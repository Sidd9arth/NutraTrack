/// Base sealed class for all application exceptions.
/// Every layer throws a subclass of this; the UI maps them to messages.
sealed class AppException implements Exception {
  const AppException(this.message, {this.code, this.originalError});

  final String message;
  final String? code;
  final Object? originalError;

  @override
  String toString() => 'AppException($code): $message';
}

// ---------------------------------------------------------------------------
// Network / Supabase
// ---------------------------------------------------------------------------

/// Wraps PostgREST, network, and Supabase client errors.
final class NetworkException extends AppException {
  const NetworkException(
    super.message, {
    super.code,
    super.originalError,
  });
}

/// Thrown when a required database record is not found.
final class NotFoundException extends AppException {
  const NotFoundException(super.message, {super.code, super.originalError});
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

/// Wraps Supabase auth errors (wrong password, email taken, etc.).
final class AuthException extends AppException {
  const AuthException(super.message, {super.code, super.originalError});
}

// ---------------------------------------------------------------------------
// Validation
// ---------------------------------------------------------------------------

/// Thrown when domain-level validation fails before hitting Supabase.
final class ValidationException extends AppException {
  const ValidationException(super.message, {super.code, super.originalError});
}

// ---------------------------------------------------------------------------
// Unexpected
// ---------------------------------------------------------------------------

/// Catch-all for errors that don't fit a known category.
final class UnknownException extends AppException {
  const UnknownException(super.message, {super.code, super.originalError});
}

// ---------------------------------------------------------------------------
// Extension: user-facing message
// ---------------------------------------------------------------------------

extension AppExceptionMessage on AppException {
  /// Returns a short, user-friendly string suitable for displaying in the UI.
  String get userMessage => switch (this) {
        AuthException e => _authMessage(e),
        NetworkException _ =>
          'A network error occurred. Please check your connection.',
        NotFoundException _ => 'The requested item could not be found.',
        ValidationException e => e.message,
        UnknownException _ => 'Something went wrong. Please try again.',
      };

  String _authMessage(AuthException e) {
    final code = e.code ?? '';
    return switch (code) {
      'invalid_credentials' => 'Incorrect email or password.',
      'email_already_in_use' => 'An account with that email already exists.',
      'weak_password' => 'Password must be at least 8 characters.',
      'user_not_found' => 'No account found with that email.',
      _ => e.message,
    };
  }
