  /// Rounds to [decimals] decimal places.
  double roundTo(int decimals) {
    final factor = _pow10(decimals);
    return (this * factor).round() / factor;
  }

  /// Converts kg to lbs.
  double get kgToLbs => this * 2.20462;

  /// Converts lbs to kg.
  double get lbsToKg => this / 2.20462;

  /// Converts cm to inches.
  double get cmToInches => this / 2.54;

  /// Converts inches to cm.
  double get inchesToCm => this * 2.54;

  /// Returns a display string with [decimals] decimal places and unit.
  String toWeightString({bool imperial = false, int decimals = 1}) {
    final value = imperial ? kgToLbs : this;
    final unit = imperial ? 'lbs' : 'kg';
    return '${value.roundTo(decimals)} $unit';
  }

  /// Returns a display string for calories, rounded to the nearest integer.
  String get toKcalString => '${toInt()} kcal';

  /// Returns a display string for grams, with 1 decimal place.
  String get toGramString => '${roundTo(1)}g';

  /// Clamps and returns a 0–1 fraction, safe for progress indicators.
  double get toFraction => clamp(0.0, 1.0);

  double _pow10(int n) {
    var result = 1.0;
    for (var i = 0; i < n; i++) {
      result *= 10;
    }
    return result;
  }
