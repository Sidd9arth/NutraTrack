## 3. Migration 002 — Core Tables

```sql
-- supabase/migrations/20240101000002_core_tables.sql

-- ============================================================
-- PROFILES
-- Extended user data. One row per auth.users row.
-- ============================================================

CREATE TABLE public.profiles (
  id               UUID PRIMARY KEY REFERENCES auth.users(id) ON DELETE CASCADE,
  display_name     TEXT,
  sex              TEXT CHECK (sex IN ('male', 'female', 'other')),
  date_of_birth    DATE,

  -- Physical stats (used in Harris-Benedict BMR fallback)
  height_cm        NUMERIC(5,1) CHECK (height_cm > 0 AND height_cm < 300),
  activity_level   TEXT CHECK (
    activity_level IN (
      'sedentary',
      'lightly_active',
      'moderately_active',
      'very_active',
      'extra_active'
    )
  ),

  -- Preferences (synced across devices via this table)
  unit_system      TEXT NOT NULL DEFAULT 'metric' CHECK (unit_system IN ('metric', 'imperial')),
  timezone         TEXT NOT NULL DEFAULT 'UTC',

  created_at       TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  updated_at       TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

COMMENT ON TABLE public.profiles IS
  'One row per authenticated user. Extended profile beyond what auth.users stores.';

COMMENT ON COLUMN public.profiles.unit_system IS
  'Stored here so unit preference syncs across devices automatically.';

COMMENT ON COLUMN public.profiles.timezone IS
  'IANA timezone string e.g. America/New_York. Used to interpret log_date correctly across device timezones.';

-- ============================================================
-- FOODS
-- Shared food database (user_id IS NULL = global/admin food)
-- plus user-created custom foods (user_id = auth.uid())
-- ============================================================

CREATE TABLE public.foods (
  id               UUID PRIMARY KEY DEFAULT gen_random_uuid(),

  -- NULL means global/shared food visible to all users.
  -- Non-null means private custom food owned by that user.
  user_id          UUID REFERENCES public.profiles(id) ON DELETE CASCADE,

  name             TEXT NOT NULL,
  brand            TEXT,
  barcode          TEXT,                     -- EAN-13, UPC-A etc. Future barcode scan support.
  serving_size_g   NUMERIC(8,2) NOT NULL CHECK (serving_size_g > 0),
  serving_label    TEXT NOT NULL DEFAULT '1 serving',   -- e.g. "1 cup", "1 slice"

  -- Per-serving macros (at serving_size_g grams)
  calories_kcal    NUMERIC(7,2) NOT NULL CHECK (calories_kcal >= 0),
  protein_g        NUMERIC(7,2) NOT NULL DEFAULT 0 CHECK (protein_g >= 0),
  carbs_g          NUMERIC(7,2) NOT NULL DEFAULT 0 CHECK (carbs_g >= 0),
  fat_g            NUMERIC(7,2) NOT NULL DEFAULT 0 CHECK (fat_g >= 0),

  -- Optional micros
  fiber_g          NUMERIC(7,2) CHECK (fiber_g >= 0),
  sugar_g          NUMERIC(7,2) CHECK (sugar_g >= 0),
  sodium_mg        NUMERIC(8,2) CHECK (sodium_mg >= 0),

  -- Provenance
  is_verified      BOOLEAN NOT NULL DEFAULT FALSE,   -- admin-verified accuracy
  source           TEXT DEFAULT 'user' CHECK (
    source IN ('user', 'admin', 'usda', 'openfoodfacts')
  ),

  created_at       TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  updated_at       TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

COMMENT ON TABLE public.foods IS
  'Food database. Rows with user_id NULL are global. Rows with user_id are private custom foods.';

COMMENT ON COLUMN public.foods.serving_size_g IS
  'The gram weight of ONE serving_label unit. All macro values are per this serving.';

-- ============================================================
-- FOOD_SERVING_ALTERNATIVES
-- Additional named serving sizes for a food.
-- e.g. "1 cup" = 240g, "1 tablespoon" = 15g
-- ============================================================

CREATE TABLE public.food_serving_alternatives (
  id               UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  food_id          UUID NOT NULL REFERENCES public.foods(id) ON DELETE CASCADE,
  label            TEXT NOT NULL,           -- "1 cup", "1 tbsp", "1 medium"
  weight_g         NUMERIC(7,2) NOT NULL CHECK (weight_g > 0)
);

-- ============================================================
-- FOOD_LOGS
-- Every food a user logs on a given day.
-- Macro values are SNAPSHOTTED at log time to prevent
-- historical data changing when a food item is later edited.
-- ============================================================

CREATE TABLE public.food_logs (
  id               UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id          UUID NOT NULL REFERENCES public.profiles(id) ON DELETE CASCADE,
  food_id          UUID NOT NULL REFERENCES public.foods(id),

  log_date         DATE NOT NULL,
  meal_type        TEXT NOT NULL CHECK (
    meal_type IN ('breakfast', 'lunch', 'dinner', 'snack')
  ),
  servings         NUMERIC(6,2) NOT NULL DEFAULT 1 CHECK (servings > 0),

  -- SNAPSHOT: values captured at log time, independent of food table edits
  serving_size_g   NUMERIC(8,2) NOT NULL,
  calories_kcal    NUMERIC(7,2) NOT NULL,
  protein_g        NUMERIC(7,2) NOT NULL,
  carbs_g          NUMERIC(7,2) NOT NULL,
  fat_g            NUMERIC(7,2) NOT NULL,
  fiber_g          NUMERIC(7,2),
  sugar_g          NUMERIC(7,2),
  sodium_mg        NUMERIC(8,2),

  notes            TEXT,

  logged_at        TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  created_at       TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  updated_at       TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

COMMENT ON TABLE public.food_logs IS
  'User food diary. Macro values are snapshotted at log time — editing a food does not change historical logs.';

-- ============================================================
-- WEIGHT_LOGS
-- One or more weight entries per day.
-- Multiple per day are allowed; trend calculations use
-- the daily average.
-- ============================================================

CREATE TABLE public.weight_logs (
  id               UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id          UUID NOT NULL REFERENCES public.profiles(id) ON DELETE CASCADE,

  log_date         DATE NOT NULL,
  weight_kg        NUMERIC(5,2) NOT NULL CHECK (weight_kg > 0 AND weight_kg < 1000),
  body_fat_pct     NUMERIC(4,1) CHECK (body_fat_pct >= 0 AND body_fat_pct <= 100),
  notes            TEXT,
  source           TEXT DEFAULT 'manual' CHECK (source IN ('manual', 'apple_health', 'google_fit')),

  logged_at        TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  created_at       TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  updated_at       TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

COMMENT ON TABLE public.weight_logs IS
  'Multiple entries per day are permitted. Calculations use daily average of weight_kg.';

-- ============================================================
-- GOALS
-- User goals. Only one should be active at a time.
-- Soft end via is_active flag; end_date is informational.
-- ============================================================

CREATE TABLE public.goals (
  id                   UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id              UUID NOT NULL REFERENCES public.profiles(id) ON DELETE CASCADE,

  goal_type            TEXT NOT NULL CHECK (goal_type IN ('cut', 'maintain', 'gain')),
  target_weight_kg     NUMERIC(5,2) CHECK (target_weight_kg > 0),
  weekly_rate_kg       NUMERIC(4,2),              -- signed: negative = cut, positive = gain

  -- Derived calorie target (computed by GoalService, stored here for display)
  calorie_target       NUMERIC(7,2),
  protein_target_g     NUMERIC(7,2),
  carbs_target_g       NUMERIC(7,2),
  fat_target_g         NUMERIC(7,2),

  -- Link to the TDEE estimate this goal was based on
  based_on_tdee        NUMERIC(7,2),

  is_active            BOOLEAN NOT NULL DEFAULT TRUE,
  start_date           DATE NOT NULL,
  end_date             DATE,

  notes                TEXT,

  created_at           TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  updated_at           TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

COMMENT ON TABLE public.goals IS
  'One active goal at a time enforced by application logic, not DB constraint, to allow atomic transitions.';

-- ============================================================
-- EXPENDITURE_HISTORY
-- Weekly TDEE estimates computed by ExpenditureService.
-- Written once per week after check-in or background compute.
-- ============================================================

CREATE TABLE public.expenditure_history (
  id                   UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id              UUID NOT NULL REFERENCES public.profiles(id) ON DELETE CASCADE,

  week_start           DATE NOT NULL,            -- always a Monday
  estimated_tdee       NUMERIC(7,2) NOT NULL,

  -- Input data snapshot for audit
  avg_intake_kcal      NUMERIC(7,2),
  avg_weight_kg        NUMERIC(6,2),
  weight_delta_kg      NUMERIC(5,3),             -- kg change over the week
  days_with_logs       INT,                       -- how many days had food logs
  computation_method   TEXT DEFAULT 'adaptive',   -- 'adaptive' or 'harris_benedict'

  created_at           TIMESTAMPTZ NOT NULL DEFAULT NOW(),

  UNIQUE (user_id, week_start)
);

-- ============================================================
-- WEEKLY_CHECKINS
-- One check-in per week. Stores recommendation output.
-- ============================================================

CREATE TABLE public.weekly_checkins (
  id                    UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id               UUID NOT NULL REFERENCES public.profiles(id) ON DELETE CASCADE,

  week_start            DATE NOT NULL,           -- Monday of the check-in week

  -- Summary of the week
  days_logged           INT,                     -- days with at least one food log entry
  avg_calories_kcal     NUMERIC(7,2),
  adherence_score       NUMERIC(4,2),            -- 0.0–1.0

  -- Recommendation output
  adjusted_calories     NUMERIC(7,2),
  adjusted_protein_g    NUMERIC(7,2),

  -- Reference to TDEE used for this check-in
  tdee_used             NUMERIC(7,2),

  notes                 TEXT,
  completed_at          TIMESTAMPTZ,

  created_at            TIMESTAMPTZ NOT NULL DEFAULT NOW(),

  UNIQUE (user_id, week_start)
);

-- ============================================================
-- FAVORITES
-- User-bookmarked foods for quick access.
-- ============================================================

CREATE TABLE public.favorites (
  id               UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id          UUID NOT NULL REFERENCES public.profiles(id) ON DELETE CASCADE,
  food_id          UUID NOT NULL REFERENCES public.foods(id) ON DELETE CASCADE,
  created_at       TIMESTAMPTZ NOT NULL DEFAULT NOW(),

  UNIQUE (user_id, food_id)
);

-- ============================================================
-- RECENT_FOODS
-- Tracks the last time a user logged each food.
-- Upserted on every log: update last_used_at and increment use_count.
-- ============================================================

CREATE TABLE public.recent_foods (
  id               UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id          UUID NOT NULL REFERENCES public.profiles(id) ON DELETE CASCADE,
  food_id          UUID NOT NULL REFERENCES public.foods(id) ON DELETE CASCADE,
  last_used_at     TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  use_count        INT NOT NULL DEFAULT 1,

  UNIQUE (user_id, food_id)
);

-- ============================================================
-- AUTH TRIGGER: create profile on sign-up
-- ============================================================

CREATE TRIGGER on_auth_user_created
  AFTER INSERT ON auth.users
  FOR EACH ROW EXECUTE FUNCTION handle_new_user();
