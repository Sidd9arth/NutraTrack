  meal_type     TEXT,
  total_kcal    NUMERIC,
  total_protein NUMERIC,
  total_carbs   NUMERIC,
  total_fat     NUMERIC,
  entry_count   INT
)
LANGUAGE SQL
STABLE
SECURITY DEFINER
AS $$
  SELECT
    fl.meal_type,
    ROUND(SUM(fl.calories_kcal), 1),
    ROUND(SUM(fl.protein_g), 1),
    ROUND(SUM(fl.carbs_g), 1),
    ROUND(SUM(fl.fat_g), 1),
    COUNT(*)::INT
  FROM public.food_logs fl
  WHERE fl.user_id = auth.uid()
    AND fl.log_date = p_date
  GROUP BY fl.meal_type
