-- supabase/migrations/20240101000003_indexes.sql

-- ============================================================
-- FOOD_LOGS — most frequently queried table
-- ============================================================

-- Primary query: all logs for a user on a given date
CREATE INDEX idx_food_logs_user_date
  ON public.food_logs (user_id, log_date DESC);

-- Analytics range queries: all logs between two dates
CREATE INDEX idx_food_logs_user_date_range
  ON public.food_logs (user_id, log_date);

-- ============================================================
-- WEIGHT_LOGS
-- ============================================================

-- Most common: fetch weight history for trend calculation
CREATE INDEX idx_weight_logs_user_date
  ON public.weight_logs (user_id, log_date DESC);

-- ============================================================
-- FOODS — search is the critical path
-- ============================================================

-- Full-text search on name and brand
CREATE INDEX idx_foods_fts
  ON public.foods
  USING GIN (to_tsvector('english', name || ' ' || COALESCE(brand, '')));

-- Trigram index for fuzzy/partial match search
CREATE INDEX idx_foods_name_trgm
  ON public.foods
  USING GIN (name gin_trgm_ops);

-- User's custom foods
CREATE INDEX idx_foods_user_id
  ON public.foods (user_id)
  WHERE user_id IS NOT NULL;

-- ============================================================
-- RECENT_FOODS
-- ============================================================

-- Ordered by recency for "recently used" list
CREATE INDEX idx_recent_foods_user_recent
  ON public.recent_foods (user_id, last_used_at DESC);

-- ============================================================
-- EXPENDITURE & CHECK-INS
-- ============================================================

CREATE INDEX idx_expenditure_user_week
  ON public.expenditure_history (user_id, week_start DESC);

CREATE INDEX idx_checkins_user_week
  ON public.weekly_checkins (user_id, week_start DESC);

-- ============================================================
-- GOALS
-- ============================================================

-- Fetch active goal quickly
CREATE INDEX idx_goals_user_active
  ON public.goals (user_id, is_active, start_date DESC);
