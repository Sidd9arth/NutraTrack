## 5. Migration 004 — Row Level Security

```sql
-- supabase/migrations/20240101000004_rls.sql

-- ============================================================
-- DESIGN PRINCIPLE
-- Every table has RLS enabled. All policies are based on
-- auth.uid(). Users can only see and modify their own data.
-- Global foods (user_id IS NULL) are readable by all users.
-- ============================================================

-- ============================================================
-- PROFILES
-- ============================================================

ALTER TABLE public.profiles ENABLE ROW LEVEL SECURITY;

CREATE POLICY "profiles: users can read own profile"
  ON public.profiles FOR SELECT
  USING (id = auth.uid());

CREATE POLICY "profiles: users can update own profile"
  ON public.profiles FOR UPDATE
  USING (id = auth.uid())
  WITH CHECK (id = auth.uid());

-- INSERT is handled by handle_new_user() trigger (SECURITY DEFINER)
-- No direct INSERT policy needed for client.

-- ============================================================
-- FOODS
-- ============================================================

ALTER TABLE public.foods ENABLE ROW LEVEL SECURITY;

-- Global foods (user_id IS NULL) visible to all authenticated users.
-- Custom foods (user_id IS NOT NULL) visible only to owner.
CREATE POLICY "foods: read global and own"
  ON public.foods FOR SELECT
  USING (user_id IS NULL OR user_id = auth.uid());

CREATE POLICY "foods: insert own custom foods only"
  ON public.foods FOR INSERT
  WITH CHECK (user_id = auth.uid());

CREATE POLICY "foods: update own custom foods only"
  ON public.foods FOR UPDATE
  USING (user_id = auth.uid())
  WITH CHECK (user_id = auth.uid());

CREATE POLICY "foods: delete own custom foods only"
  ON public.foods FOR DELETE
  USING (user_id = auth.uid());

-- ============================================================
-- FOOD_SERVING_ALTERNATIVES
-- Visible if the parent food is visible (global or own).
-- ============================================================

ALTER TABLE public.food_serving_alternatives ENABLE ROW LEVEL SECURITY;

CREATE POLICY "serving_alternatives: read if food is visible"
  ON public.food_serving_alternatives FOR SELECT
  USING (
    EXISTS (
      SELECT 1 FROM public.foods f
      WHERE f.id = food_id
        AND (f.user_id IS NULL OR f.user_id = auth.uid())
    )
  );

CREATE POLICY "serving_alternatives: insert for own foods"
  ON public.food_serving_alternatives FOR INSERT
  WITH CHECK (
    EXISTS (
      SELECT 1 FROM public.foods f
      WHERE f.id = food_id AND f.user_id = auth.uid()
    )
  );

CREATE POLICY "serving_alternatives: delete for own foods"
  ON public.food_serving_alternatives FOR DELETE
  USING (
    EXISTS (
      SELECT 1 FROM public.foods f
      WHERE f.id = food_id AND f.user_id = auth.uid()
    )
  );

-- ============================================================
-- FOOD_LOGS
-- ============================================================

ALTER TABLE public.food_logs ENABLE ROW LEVEL SECURITY;

CREATE POLICY "food_logs: full access to own rows"
  ON public.food_logs FOR ALL
  USING (user_id = auth.uid())
  WITH CHECK (user_id = auth.uid());

-- ============================================================
-- WEIGHT_LOGS
-- ============================================================

ALTER TABLE public.weight_logs ENABLE ROW LEVEL SECURITY;

CREATE POLICY "weight_logs: full access to own rows"
  ON public.weight_logs FOR ALL
  USING (user_id = auth.uid())
  WITH CHECK (user_id = auth.uid());

-- ============================================================
-- GOALS
-- ============================================================

ALTER TABLE public.goals ENABLE ROW LEVEL SECURITY;

CREATE POLICY "goals: full access to own rows"
  ON public.goals FOR ALL
  USING (user_id = auth.uid())
  WITH CHECK (user_id = auth.uid());

-- ============================================================
-- EXPENDITURE_HISTORY
-- ============================================================

ALTER TABLE public.expenditure_history ENABLE ROW LEVEL SECURITY;

CREATE POLICY "expenditure_history: full access to own rows"
  ON public.expenditure_history FOR ALL
  USING (user_id = auth.uid())
  WITH CHECK (user_id = auth.uid());

-- ============================================================
-- WEEKLY_CHECKINS
-- ============================================================

