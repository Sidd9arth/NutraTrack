-- upsert_recent_food
-- Called explicitly by the client when a food is logged.
-- The trigger on food_logs also calls this, but the function
-- is exposed for future use (e.g., viewing a food detail page).
-- ============================================================

CREATE OR REPLACE FUNCTION upsert_recent_food(p_food_id UUID)
RETURNS VOID
LANGUAGE SQL
VOLATILE
SECURITY DEFINER
AS $$
  INSERT INTO public.recent_foods (user_id, food_id, last_used_at, use_count)
  VALUES (auth.uid(), p_food_id, NOW(), 1)
  ON CONFLICT (user_id, food_id)
  DO UPDATE SET
    last_used_at = NOW(),
    use_count = recent_foods.use_count + 1;
$$;

-- ============================================================
-- toggle_favorite
-- Adds or removes a food from favourites.
-- Returns TRUE if food is now a favourite, FALSE if removed.
-- ============================================================

CREATE OR REPLACE FUNCTION toggle_favorite(p_food_id UUID)
RETURNS BOOLEAN
LANGUAGE plpgsql
VOLATILE
SECURITY DEFINER
AS $$
DECLARE
  v_exists BOOLEAN;
BEGIN
  SELECT EXISTS (
    SELECT 1 FROM public.favorites
    WHERE user_id = auth.uid() AND food_id = p_food_id
  ) INTO v_exists;

  IF v_exists THEN
    DELETE FROM public.favorites
    WHERE user_id = auth.uid() AND food_id = p_food_id;
    RETURN FALSE;
  ELSE
    INSERT INTO public.favorites (user_id, food_id)
    VALUES (auth.uid(), p_food_id);
    RETURN TRUE;
  END IF;
END;
$$;

-- ============================================================
-- get_dashboard_summary
-- Single RPC for the dashboard screen. Returns daily totals
-- plus goal targets in one round trip.
-- Used by: DashboardScreen on mount.
-- ============================================================

CREATE OR REPLACE FUNCTION get_dashboard_summary(p_date DATE)
RETURNS JSON
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
AS $$
DECLARE
  v_result JSON;
BEGIN
  SELECT json_build_object(
    'date', p_date,
    'nutrition', (
      SELECT json_build_object(
        'total_kcal',    ROUND(COALESCE(SUM(calories_kcal), 0), 1),
        'total_protein', ROUND(COALESCE(SUM(protein_g), 0), 1),
        'total_carbs',   ROUND(COALESCE(SUM(carbs_g), 0), 1),
        'total_fat',     ROUND(COALESCE(SUM(fat_g), 0), 1),
        'entry_count',   COUNT(*)
      )
      FROM public.food_logs
      WHERE user_id = auth.uid() AND log_date = p_date
    ),
    'weight_today', (
      SELECT json_build_object(
        'avg_kg', ROUND(AVG(weight_kg), 2),
        'count',  COUNT(*)
      )
      FROM public.weight_logs
      WHERE user_id = auth.uid() AND log_date = p_date
    ),
    'active_goal', (
      SELECT row_to_json(g)
      FROM (
        SELECT id, goal_type, calorie_target, protein_target_g,
               carbs_target_g, fat_target_g, target_weight_kg, weekly_rate_kg
        FROM public.goals
        WHERE user_id = auth.uid() AND is_active = TRUE
        LIMIT 1
      ) g
    )
  ) INTO v_result;

  RETURN v_result;
END;
$$;

COMMENT ON FUNCTION get_dashboard_summary IS
  'Single round-trip RPC for dashboard: daily nutrition totals + todays weight + active goal targets.';

-- ============================================================
-- get_logging_streak
-- Returns current consecutive days logged (ending today or yesterday).
-- Used by: DashboardScreen streak display.
-- ============================================================

CREATE OR REPLACE FUNCTION get_logging_streak()
RETURNS INT
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
AS $$
DECLARE
  v_streak   INT := 0;
  v_check    DATE := CURRENT_DATE;
  v_has_log  BOOLEAN;
BEGIN
  -- Check today first; if no log today, start from yesterday
  SELECT EXISTS (
    SELECT 1 FROM public.food_logs
    WHERE user_id = auth.uid() AND log_date = v_check
  ) INTO v_has_log;

  IF NOT v_has_log THEN
    v_check := v_check - 1;
  END IF;

  -- Walk backwards until a day with no log
  LOOP
    SELECT EXISTS (
      SELECT 1 FROM public.food_logs
      WHERE user_id = auth.uid() AND log_date = v_check
    ) INTO v_has_log;

    EXIT WHEN NOT v_has_log;

    v_streak := v_streak + 1;
    v_check  := v_check - 1;
  END LOOP;

  RETURN v_streak;
END;
$$;

-- ============================================================
-- get_check_in_data
-- Returns all inputs needed by CheckInService:
-- last week's daily calories and weight entries.
-- ============================================================

CREATE OR REPLACE FUNCTION get_check_in_data(p_week_start DATE)
RETURNS JSON
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
AS $$
DECLARE
  v_week_end DATE := p_week_start + 6;
BEGIN
  RETURN json_build_object(
    'week_start', p_week_start,
    'week_end',   v_week_end,
    'daily_calories', (
      SELECT json_agg(row_to_json(t))
      FROM (
        SELECT log_date, ROUND(SUM(calories_kcal), 1) AS total_kcal
        FROM public.food_logs
        WHERE user_id = auth.uid()
          AND log_date >= p_week_start
          AND log_date <= v_week_end
        GROUP BY log_date
        ORDER BY log_date
      ) t
    ),
    'daily_weights', (
      SELECT json_agg(row_to_json(t))
      FROM (
        SELECT log_date, ROUND(AVG(weight_kg), 2) AS avg_weight_kg
        FROM public.weight_logs
        WHERE user_id = auth.uid()
          AND log_date >= p_week_start
          AND log_date <= v_week_end
        GROUP BY log_date
        ORDER BY log_date
      ) t
    ),
    'active_goal', (
      SELECT row_to_json(g)
      FROM (
        SELECT calorie_target, protein_target_g, goal_type, weekly_rate_kg
        FROM public.goals
        WHERE user_id = auth.uid() AND is_active = TRUE
        LIMIT 1
      ) g
    )
  );
END;
$$;
