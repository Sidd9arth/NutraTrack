-- ============================================================
-- get_weight_log_window
-- Returns all weight entries in a date range with the
-- daily average pre-computed. Trend calculation uses the
-- daily average, not raw entries.
-- Used by: WeightTrendService (Dart), WeightChart.
-- ============================================================

CREATE OR REPLACE FUNCTION get_weight_log_window(
  p_from DATE,
  p_to   DATE
)
RETURNS TABLE (
  log_date       DATE,
  avg_weight_kg  NUMERIC,
  min_weight_kg  NUMERIC,
  max_weight_kg  NUMERIC,
  entry_count    INT
)
LANGUAGE SQL
STABLE
SECURITY DEFINER
AS $$
  SELECT
    wl.log_date,
    ROUND(AVG(wl.weight_kg), 2)  AS avg_weight_kg,
    ROUND(MIN(wl.weight_kg), 2)  AS min_weight_kg,
    ROUND(MAX(wl.weight_kg), 2)  AS max_weight_kg,
    COUNT(*)::INT                 AS entry_count
  FROM public.weight_logs wl
  WHERE wl.user_id = auth.uid()
    AND wl.log_date >= p_from
    AND wl.log_date <= p_to
  GROUP BY wl.log_date
  ORDER BY wl.log_date;
$$;

COMMENT ON FUNCTION get_weight_log_window IS
  'Returns daily average weight for each day in range. WeightTrendService uses avg_weight_kg for EWMA.';

-- ============================================================
-- get_weekly_expenditure_inputs
-- Returns per-week aggregates needed by ExpenditureService:
-- average intake, average weight, and weight change.
-- Used by: ExpenditureService (Dart side does final calc).
-- ============================================================

CREATE OR REPLACE FUNCTION get_weekly_expenditure_inputs(
  p_from DATE,  -- start of oldest week (Monday)
  p_to   DATE   -- end of most recent week (Sunday)
)
RETURNS TABLE (
  week_start         DATE,
  avg_intake_kcal    NUMERIC,
  days_with_logs     INT,
  avg_weight_kg      NUMERIC,
  start_weight_kg    NUMERIC,
  end_weight_kg      NUMERIC
)
LANGUAGE SQL
STABLE
SECURITY DEFINER
AS $$
  WITH weekly_intake AS (
    SELECT
      date_trunc('week', fl.log_date)::DATE AS week_start,
      ROUND(AVG(daily_totals.day_kcal), 1)  AS avg_intake_kcal,
      COUNT(DISTINCT fl.log_date)::INT       AS days_with_logs
    FROM public.food_logs fl
    JOIN (
      SELECT log_date, SUM(calories_kcal) AS day_kcal
      FROM public.food_logs
      WHERE user_id = auth.uid()
      GROUP BY log_date
    ) daily_totals ON daily_totals.log_date = fl.log_date
    WHERE fl.user_id = auth.uid()
      AND fl.log_date >= p_from
      AND fl.log_date <= p_to
    GROUP BY week_start
  ),
  weekly_weight AS (
    SELECT
      date_trunc('week', wl.log_date)::DATE AS week_start,
      ROUND(AVG(wl.weight_kg), 2)           AS avg_weight_kg,
      FIRST_VALUE(wl.weight_kg) OVER (
        PARTITION BY date_trunc('week', wl.log_date)
        ORDER BY wl.log_date ASC
      )                                      AS start_weight_kg,
      LAST_VALUE(wl.weight_kg) OVER (
        PARTITION BY date_trunc('week', wl.log_date)
        ORDER BY wl.log_date ASC
        ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING
      )                                      AS end_weight_kg
    FROM public.weight_logs wl
    WHERE wl.user_id = auth.uid()
      AND wl.log_date >= p_from
      AND wl.log_date <= p_to
  )
  SELECT
    wi.week_start,
    wi.avg_intake_kcal,
    wi.days_with_logs,
    ROUND(ww.avg_weight_kg, 2),
    ROUND(ww.start_weight_kg, 2),
    ROUND(ww.end_weight_kg, 2)
  FROM weekly_intake wi
  LEFT JOIN weekly_weight ww ON ww.week_start = wi.week_start
  ORDER BY wi.week_start;
$$;

-- ============================================================
-- search_foods
-- Hybrid search: full-text + trigram similarity.
-- Returns user's custom foods first, then global foods.
-- Used by: FoodSearchService, FoodSearchScreen.
-- ============================================================

CREATE OR REPLACE FUNCTION search_foods(
  p_query TEXT,
  p_limit INT DEFAULT 25
)
RETURNS TABLE (
  id             UUID,
  user_id        UUID,
  name           TEXT,
  brand          TEXT,
  serving_size_g NUMERIC,
  serving_label  TEXT,
  calories_kcal  NUMERIC,
  protein_g      NUMERIC,
  carbs_g        NUMERIC,
  fat_g          NUMERIC,
  is_verified    BOOLEAN,
  is_custom      BOOLEAN,
  rank           REAL
)
LANGUAGE SQL
STABLE
SECURITY DEFINER
AS $$
  SELECT
    f.id,
    f.user_id,
    f.name,
    f.brand,
    f.serving_size_g,
    f.serving_label,
    f.calories_kcal,
    f.protein_g,
    f.carbs_g,
    f.fat_g,
    f.is_verified,
    (f.user_id = auth.uid()) AS is_custom,
    (
      ts_rank(
        to_tsvector('english', f.name || ' ' || COALESCE(f.brand, '')),
        plainto_tsquery('english', p_query)
      )
      + similarity(f.name, p_query) * 0.3
      -- Boost user's own foods
      + CASE WHEN f.user_id = auth.uid() THEN 0.5 ELSE 0 END
      -- Boost verified global foods
      + CASE WHEN f.is_verified THEN 0.2 ELSE 0 END
    ) AS rank
  FROM public.foods f
  WHERE
    (f.user_id IS NULL OR f.user_id = auth.uid())
    AND (
      to_tsvector('english', f.name || ' ' || COALESCE(f.brand, ''))
        @@ plainto_tsquery('english', p_query)
      OR similarity(f.name, p_query) > 0.15
      OR f.name ILIKE '%' || p_query || '%'
    )
  ORDER BY rank DESC
  LIMIT p_limit;
$$;

COMMENT ON FUNCTION search_foods IS
  'Hybrid FTS + trigram search. User custom foods ranked first, then verified global foods.';

